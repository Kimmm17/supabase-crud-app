# Frontend-safe (publishable) values only.
# Copy this file to `.env` and fill in values from:
# Supabase Dashboard → Project Settings → API

# Project URL — safe to expose in the browser
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon / public (or "publishable") key — safe for frontend use.
# It is restricted by Row Level Security. Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here
